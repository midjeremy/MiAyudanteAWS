# Scrapers: domingos a las 03:00 UTC (INACAP) y 05:00 UTC (Duoc UC)
0 3 * * 0 ubuntu cd /home/ubuntu/MiAyudanteAWS/backend_api && flock -n /tmp/scraper_inacap.lock /home/ubuntu/MiAyudanteAWS/venv/bin/python manage.py run_inacap_scraper >> /home/ubuntu/scraper_inacap.log 2>&1
0 5 * * 0 ubuntu cd /home/ubuntu/MiAyudanteAWS/backend_api && flock -n /tmp/scraper_duoc.lock /home/ubuntu/MiAyudanteAWS/venv/bin/python manage.py run_duoc_scraper >> /home/ubuntu/scraper_duoc.log 2>&1

# Ley 21.719 (plazo de conservación): el día 1 de cada mes a las 06:00 UTC se eliminan las cuentas sin acceso en 24 meses
0 6 1 * * ubuntu cd /home/ubuntu/MiAyudanteAWS/backend_api && /home/ubuntu/MiAyudanteAWS/venv/bin/python manage.py purgar_cuentas_inactivas >> /home/ubuntu/purga_cuentas.log 2>&1
