[Unit]
Description=Gunicorn de Mi Ayudante (Django)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/MiAyudanteAWS/backend_api
ExecStart=/home/ubuntu/MiAyudanteAWS/venv/bin/gunicorn miayudante_api.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
